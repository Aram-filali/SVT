generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum SessionMode {
  PRESENTIEL
  ONLINE
}

enum ClassSessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum RegistrationRequestStatus {
  PENDING
  NEED_INFO
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ResourceType {
  PDF
  DOCUMENT
  IMAGE
  VIDEO
  LINK
  OTHER
}

enum ResourceStatus {
  ACTIVE
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EvaluationType {
  TEST
  EXAM
  QUIZ
  HOMEWORK
  PRACTICAL
  OTHER
}

enum EvaluationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  REGISTRATION_REQUEST
  EVALUATION
  EVALUATION_RESULT
  RESOURCE
  CLASS_SESSION
  SYSTEM
}

model User {
  id                 String                @id @default(uuid())
  email              String                @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               Role
  status             AccountStatus         @default(PENDING)
  phone              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  student            Student?
  parent             Parent?
  teacher            Teacher?
  sessions           Session[]
  processedRequests  RegistrationRequest[] @relation("ProcessedByUser")
  uploadedResources  Resource[]            @relation("UploadedByUser")
  markedAttendances  Attendance[]          @relation("AttendanceMarkedBy")
  createdEvaluations Evaluation[]          @relation("EvaluationCreatedBy")
  gradedResults      EvaluationResult[]    @relation("EvaluationGradedBy")
  notifications      Notification[]        @relation("UserNotifications")

  @@map("users")
}

model Student {
  id                   String                @id @default(uuid())
  userId               String                @unique
  level                String?
  section              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parents              ParentStudent[]
  enrollments          Enrollment[]
  registrationRequests RegistrationRequest[]
  attendances          Attendance[]
  evaluationResults    EvaluationResult[]

  @@map("students")
}

model Parent {
  id                   String                @id @default(uuid())
  userId               String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  children             ParentStudent[]
  registrationRequests RegistrationRequest[]

  @@map("parents")
}

model Teacher {
  id        String    @id @default(uuid())
  userId    String    @unique
  bio       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups    Group[]

  @@map("teachers")
}

model ParentStudent {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_students")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Group {
  id                   String                @id @default(uuid())
  name                 String
  description          String?
  level                String
  capacity             Int
  teacherId            String
  status               GroupStatus           @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  teacher              Teacher               @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments          Enrollment[]
  sessions             ClassSession[]
  registrationRequests RegistrationRequest[]
  resources            Resource[]
  evaluations          Evaluation[]

  @@index([teacherId])
  @@index([status])
  @@map("groups")
}

model Enrollment {
  id        String           @id @default(uuid())
  studentId String
  groupId   String
  status    EnrollmentStatus @default(ACTIVE)
  startDate DateTime         @default(now())
  endDate   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([groupId])
  @@index([status])
  @@map("enrollments")
}

model ClassSession {
  id          String             @id @default(uuid())
  groupId     String
  startAt     DateTime
  endAt       DateTime
  mode        SessionMode        @default(PRESENTIEL)
  location    String?
  meetingUrl  String?
  status      ClassSessionStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  group       Group              @relation(fields: [groupId], references: [id], onDelete: Restrict)
  resources   Resource[]
  attendances Attendance[]
  evaluations Evaluation[]

  @@index([groupId])
  @@index([startAt])
  @@index([status])
  @@map("class_sessions")
}

model RegistrationRequest {
  id              String                    @id @default(uuid())
  studentId       String
  parentId        String?
  groupId         String?
  requestedLevel  String?
  message         String?
  status          RegistrationRequestStatus @default(PENDING)
  teacherMessage  String?
  responseMessage String?
  processedById   String?
  processedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  student         Student                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  parent          Parent?                   @relation(fields: [parentId], references: [id], onDelete: SetNull)
  group           Group?                    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  processedBy     User?                     @relation("ProcessedByUser", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([parentId])
  @@index([groupId])
  @@index([status])
  @@map("registration_requests")
}

model Resource {
  id           String         @id @default(uuid())
  title        String
  description  String?
  type         ResourceType
  storageKey   String?
  externalUrl  String?
  mimeType     String?
  fileSize     Int?
  groupId      String?
  sessionId    String?
  uploadedById String
  status       ResourceStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  group        Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  session      ClassSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  uploadedBy   User           @relation("UploadedByUser", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([sessionId])
  @@index([uploadedById])
  @@index([status])
  @@map("resources")
}

model Attendance {
  id         String           @id @default(uuid())
  sessionId  String
  studentId  String
  status     AttendanceStatus
  note       String?
  markedById String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  session    ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  markedBy   User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([status])
  @@map("attendances")
}

model Evaluation {
  id          String           @id @default(uuid())
  title       String
  description String?
  type        EvaluationType
  date        DateTime
  maxScore    Decimal          @db.Decimal(5, 2)
  coefficient Decimal?         @db.Decimal(5, 2)
  groupId     String
  sessionId   String?
  status      EvaluationStatus @default(DRAFT)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  group       Group            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  session     ClassSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("EvaluationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  results     EvaluationResult[]

  @@index([groupId])
  @@index([sessionId])
  @@index([createdById])
  @@index([status])
  @@index([date])
  @@map("evaluations")
}

model EvaluationResult {
  id           String     @id @default(uuid())
  evaluationId String
  studentId    String
  score        Decimal    @db.Decimal(5, 2)
  comment      String?
  gradedById   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  gradedBy     User?      @relation("EvaluationGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([evaluationId, studentId])
  @@index([evaluationId])
  @@index([studentId])
  @@index([gradedById])
  @@map("evaluation_results")
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  type           NotificationType
  title          String
  message        String
  link           String?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  resourceType   String?
  resourceId     String?
  idempotencyKey String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@map("notifications")
}